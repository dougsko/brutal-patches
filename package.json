{
  "name": "brutal-patches",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config src/proxy.conf.json",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --no-watch --browsers=ChromeHeadless",
    "start:all": "npm --prefix server-src run start:dev & npm run start",
    "deploy": "bash scripts/deploy.sh",
    "deploy:backend": "cd server-src && npm run deploy",
    "deploy:frontend": "npm run build:prod && aws s3 sync dist/ s3://$S3_BUCKET_NAME --delete"
  },
  "private": true,
  "engines": {
    "node": "^22.0.0",
    "npm": "^10.0.0"
  },
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@fastify/static": "^8.2.0",
    "angular-awesome-slider": "^2.4.4",
    "chart.js": "^4.5.0",
    "crypto-js": "^4.2.0",
    "hammerjs": "^2.0.8",
    "jquery": "^3.6.0",
    "jquery-knob": "^1.2.11",
    "jquery-slider": "^0.0.1",
    "jquery-templates": "^1.0.0",
    "jquery-ui": "^1.13.0",
    "jqwidgets-ng": "^14.1.17",
    "jsplumb": "^2.15.6",
    "jwt-decode": "^4.0.0",
    "ng2-charts": "^7.0.0",
    "rxjs": "~7.5.7",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.3",
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@babel/core": "^8.0.10",
    "@babel/preset-env": "^8.0.7",
    "@jefiozie/ngx-aws-deploy": "^4.1.0",
    "@playwright/test": "^1.64.1",
    "@types/crypto-js": "^4.2.2",
    "@types/jasmine": "~4.3.0",
    "@types/node": "^6.0.0",
    "babel-jest": "^30.5.2",
    "jasmine-core": "~4.4.0",
    "karma": "~6.4.1",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.22.4"
  }
}
